  },
  "scripts": {
    "prepublishOnly": "npm test -- --runInBand",
    "prepack": "npm run build",
    "start": "npm run compile && node build/main/playground/index.js",
    "record": "npm run compile && node build/main/playground/record.js",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:link": "npm run build && npm link",
    "type-check:watch": "npm run type-check -- --watch",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint",
    "clean": "node -e \"require('node:fs').rmSync('build', {recursive: true, force: true})\"",
    "compile": "tsc -p .",
    "fix": "eslint . --fix && prettier --write \"src/**/*.ts\" \"*.js\"",
    "test": "jest",
    "pretest": "npm run type-check",
    "posttest": "npm run lint",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"*.js\""
  },
