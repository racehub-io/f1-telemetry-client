  },
  "dependencies": {
    "binary-parser": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/n-readlines": "^1.0.3",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
