{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "sourceMap": true,
    "strict": true,
    "rootDir": "src",
    "outDir": "build/main",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "ES2020"
  },
  "include": ["src/**/*.ts"]
}
